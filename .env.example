# Alamat project Supabase dan kunci publik. Aman dipakai di browser karena dibatasi RLS.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Kunci server. Jangan pernah diberi awalan NEXT_PUBLIC_ dan jangan di-commit.
SUPABASE_SERVICE_ROLE_KEY=

# Alamat publik aplikasi, dipakai untuk tautan verifikasi email dan tautan reset.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Layanan email untuk verifikasi akun dan peringatan retensi.
RESEND_API_KEY=
EMAIL_PENGIRIM=CatatanHD <no-reply@contoh.id>

# Super admin pertama. Hanya dipakai oleh perintah npm run admin:buat.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_WHATSAPP=6280000000000

# Zona waktu perhitungan tanggal. Ubah hanya jika unit HD berada di zona lain.
APP_TZ=Asia/Jakarta

# Rahasia pemanggil endpoint retensi harian.
CRON_SECRET=
